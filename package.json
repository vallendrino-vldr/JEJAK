{
  "name": "jejak",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integrasi": "vitest run --config vitest.integration.mts",
    "db:test": "node scripts/db-test.mjs",
    "secret:scan": "node scripts/secret-scan.mjs",
    "security:audit": "pnpm audit --prod --audit-level=high",
    "check": "pnpm format:check && pnpm secret:scan && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "gate:integrasi": "pnpm test:integrasi && pnpm db:test",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "workflow": "4.8.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.13.1",
    "supabase": "^2.113.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,json,css,md,yml,yaml}": "prettier --write",
    "*.{js,mjs,cjs,ts,tsx}": "eslint --fix --max-warnings=0"
  }
}
